# Copie ce fichier en .env.local et remplis les valeurs (voir mentio-brief.md §14)

# LLM
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Modèles de traitement — palier gratuit (juge, génération de questions, Prospecteur)
OPENROUTER_API_KEY=

# Prospecteur (scripts/prospection) — modèles gratuits UNIQUEMENT, jamais de payant.
# GEMINI_FREE_API_KEY doit venir d'un projet AI Studio SANS facturation : la clé
# GOOGLE_GENERATIVE_AI_API_KEY ci-dessus vit sur un projet facturé, où chaque
# recherche web est un forfait. Deux variables, pour que la confusion soit impossible.
GEMINI_FREE_API_KEY=
MISTRAL_API_KEY=
# Plafonds quotidiens d'appels. Celui d'OpenRouter est partagé avec le juge du
# Baromètre : on le laisse sous les 50 requêtes/jour du palier gratuit.
PROSPECT_CAP_OPENROUTER=35
PROSPECT_CAP_GEMINI=300
PROSPECT_CAP_MISTRAL=200

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# Inngest (prod uniquement — inutile en local avec `npx inngest-cli dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Le fondateur — le seul destinataire que les agents écrivent sans relecture.
# Toute notification (message, lead, demande d'ajout, paiement, alerte, bilan du
# dimanche) part vers la boîte de l'ENTREPRISE — jamais une adresse personnelle.
# Vide = CONTACT_INBOX, puis hello@mentio.fr.
FOUNDER_EMAIL=
# Comptes Mentio autorisés à ouvrir le cockpit /admin (virgules). Créez-vous un
# compte sur le site avec l'adresse de l'entreprise, puis mettez-la ici.
ADMIN_EMAILS=
# Notification anonyme sur téléphone (appli gratuite ntfy, sans compte) : choisir
# un nom long et imprévisible, s'y abonner dans l'appli. Aucune adresse ni message
# de tiers n'y transite, seulement le type d'événement et le lien du cockpit.
NTFY_TOPIC=

# Plafonds de dépense des usages sans revenu (dollars). Mensuel par défaut : 8.
# SPEND_CAP_MONTHLY=8
# SPEND_CAP_INDEX=3

# Développement local sans Supabase : sert les données de démonstration
# (content/etude-2026-07-data.json). Jamais en production.
# MENTIO_FIXTURES=1
